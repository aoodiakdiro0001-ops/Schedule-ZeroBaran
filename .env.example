# ============================================================
# Schedule-ZeroBaran - متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم بمفاتيحك الحقيقية
# المؤلف: Baran Avisat (Baranavisat@gmail.com)
# ============================================================

# ----- Supabase (قاعدة البيانات) -----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ----- Google Gemini API (الذكاء الاصطناعي) -----
# احصل عليه مجاناً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# ----- Groq API (بديل سريع ومجاني للذكاء الاصطناعي) -----
# احصل عليه مجاناً من: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# اختر مزود الذكاء الاصطناعي: gemini أو groq
AI_PROVIDER=gemini

# ----- Telegram Bot (قناة التنبيهات والاستقبال) -----
# احصل عليه من @BotFather على تليجرام
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# معرّف الدردشة الخاص بك (احصل عليه من @userinfobot)
TELEGRAM_OWNER_CHAT_ID=your_telegram_chat_id
# رابط اجتماع افتراضي افتراضي (يمكن استبداله بميت/زوم/جوجل ميت)
DEFAULT_MEETING_URL=https://meet.google.com/your-default-meeting

# ----- إعدادات المنظومة -----
# المنطقة الزمنية (Europe/Istanbul مثلاً)
TIMEZONE=Europe/Istanbul
# مدة الجلسة الواحدة بالدقائق
SESSION_DURATION_MINUTES=60
# عدد أيام الإتاحة المعروضة للعميل
AVAILABILITY_WINDOW_DAYS=14
# المنفذ المحلي
PORT=8000

# ----- معلومات المالك (للإشعارات والتواصل) -----
OWNER_NAME=Baran Avisat
OWNER_EMAIL=Baranavisat@gmail.com
OWNER_WHATSAPP=00905313263722
OWNER_BUSINESS_NAME=Schedule-ZeroBaran Smart Office
